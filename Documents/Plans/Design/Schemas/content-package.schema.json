          "type": "object",
          "properties": {
            "targetScreenX": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 0.6
            },
            "lookAheadSeconds": {
              "type": "number",
              "minimum": 0
            },
            "minLookAhead": {
              "type": "number",
              "minimum": 0
            },
            "maxLookAhead": {
              "type": "number",
              "minimum": 0
            },
            "deadZoneSize": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "verticalLookAheadSeconds": {
              "type": "number",
              "minimum": 0
            },
            "maxVerticalOffset": {
              "type": "number",
              "minimum": 0
            },
            "smoothingSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maxCatchUpSpeed": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "baseViewHeight": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minViewHeight": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maxViewHeight": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "zoomSmoothingSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reactionBudgetSeconds": {
              "type": "number",
              "exclusiveMinimum": 0

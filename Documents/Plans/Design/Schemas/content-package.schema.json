          },
          "minItems": 1
        },
        "groundAcceleration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "airAcceleration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxHorizontalSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxFallSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "groundProbeDistance": {
          "type": "number",
          "exclusiveMinimum": 0

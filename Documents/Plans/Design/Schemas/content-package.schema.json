        "airAcceleration",
        "maxHorizontalSpeed",
        "maxFallSpeed",
        "groundProbeDistance",
        "collisionSkin",
        "standClearancePadding",
        "vaultMaxWidth",
        "vaultAcquisitionDistance",
        "vaultDurationSeconds",
        "vaultExitSpeed",
        "landingRecoverySeconds",
        "maxBufferedActions",
        "camera",
        "contextInputSeconds",
        "vaultTrajectory",
        "gripOffset"

        "gravity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "runSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "jumpVelocity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "jumpBufferSeconds": {
          "type": "number",
          "minimum": 0
        },
        "coyoteSeconds": {
          "type": "number",
          "minimum": 0
        },
        "slideSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "vaultMaxHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bodySize": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2

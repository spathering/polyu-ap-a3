{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parkour content package",
  "description": "Shared game/editor structural contract; scene action markers reference geometry rather than copy it.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.2.0"
    },
    "contentRevision": {
      "type": "string",
      "minLength": 1
    },
    "physicsVersion": {
      "type": "string",
      "minLength": 1
    },
    "generatorVersion": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "$ref": "#/$defs/rules"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      },
      "minItems": 4
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      },
      "minItems": 1
    },
    "finiteLevels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finiteLevel"
      },
      "minItems": 1
    },
    "endlessPresets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/endlessPreset"
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "contentRevision",
    "physicsVersion",
    "generatorVersion",
    "rules",
    "profiles",
    "modules",
    "finiteLevels",
    "endlessPresets"
  ],
  "additionalProperties": false,

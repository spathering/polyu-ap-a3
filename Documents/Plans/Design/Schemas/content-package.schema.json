        },
        "vaultDurationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "vaultExitSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "landingRecoverySeconds": {
          "type": "number",
          "minimum": 0
        },
        "maxBufferedActions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
